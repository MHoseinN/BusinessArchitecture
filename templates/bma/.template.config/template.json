{
  "$schema": "http://json.schemastore.org/template",
  "author": "BusinessArchitecture",
  "classifications": ["Web", "Architecture", "ModularMonolith"],
  "identity": "BusinessArchitecture.Solution",
  "name": "Business Modular Architecture",
  "shortName": "bma",
  "sourceName": "BusinessTemplate",
  "preferNameDirectory": true,
  "symbols": {
    "database": {
      "type": "parameter",
      "datatype": "choice",
      "choices": [{"choice":"postgres"}],
      "defaultValue": "postgres"
    },
    "includeDocker": {
      "type": "parameter",
      "datatype": "bool",
      "defaultValue": "true"
    },
    "includeSampleModule": {
      "type": "parameter",
      "datatype": "bool",
      "defaultValue": "true"
    },
    "includeAuth": {
      "type": "parameter",
      "datatype": "bool",
      "defaultValue": "true"
    },
    "includeOutbox": {
      "type": "parameter",
      "datatype": "bool",
      "defaultValue": "true"
    },
    "multiTenant": {
      "type": "parameter",
      "datatype": "bool",
      "defaultValue": "false"
    }
  },
  "sources": [
    {
      "exclude": [
        "**/[Bb]in/**",
        "**/[Oo]bj/**",
        ".git/**",
        ".vs/**",
        ".idea/**",
        "**/TestResults/**",
        "**/coverage/**",
        "**/artifacts/**"
      ]
    }
  ]
}
